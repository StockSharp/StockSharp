<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="StockSharp.Samples.Avalonia.SampleApplication"
             RequestedThemeVariant="Dark">
  <Application.Styles>
    <FluentTheme DensityStyle="Compact" />
    <StyleInclude Source="avares://StockSharp.Xaml.Avalonia/Themes/StockSharpControls.axaml" />
  </Application.Styles>
</Application>
