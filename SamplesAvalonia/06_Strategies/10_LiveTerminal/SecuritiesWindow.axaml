<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:grids="using:StockSharp.Xaml.Grids.Avalonia"
        x:Class="StockSharp.Samples.Strategies.LiveTerminal.Avalonia.SecuritiesWindow"
        Title="Securities"
        Width="1080"
        Height="520"
        MinWidth="720"
        MinHeight="360">
  <Grid RowDefinitions="*,Auto">
    <grids:SecurityPicker x:Name="SecurityPicker" />
    <Grid Grid.Row="1" Margin="4" ColumnDefinitions="110,*,110,110,110">
      <Button Content="Find..." Click="OnFindClick" />
      <Button x:Name="Level1Button" Grid.Column="2" Margin="2,0" Content="Bid/Ask" Click="OnLevel1Click" IsEnabled="False" />
      <Button x:Name="DepthButton" Grid.Column="3" Margin="2,0" Content="Depth..." Click="OnDepthClick" IsEnabled="False" />
      <Button x:Name="NewOrderButton" Grid.Column="4" Margin="2,0" Content="New order..." Click="OnNewOrderClick" IsEnabled="False" />
    </Grid>
  </Grid>
</Window>
