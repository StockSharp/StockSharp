<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:grids="using:StockSharp.Xaml.Grids.Avalonia"
        x:Class="StockSharp.Samples.Strategies.LiveTerminal.Avalonia.StrategiesWindow"
        Title="Strategies"
        Width="980"
        Height="480"
        MinWidth="700"
        MinHeight="320">
  <Grid Margin="5" RowDefinitions="*,Auto">
    <grids:StrategiesDashboard x:Name="StrategiesDashboard" />
    <Button Grid.Row="1" Width="150" Margin="0,5,0,0" HorizontalAlignment="Left" Content="Add quoting..." Click="OnAddQuotingClick" />
  </Grid>
</Window>
