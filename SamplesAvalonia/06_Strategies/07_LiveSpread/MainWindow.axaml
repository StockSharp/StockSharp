<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:editors="using:StockSharp.Xaml.PropertyGrid.Avalonia.Editors"
        xmlns:grids="using:StockSharp.Xaml.Grids.Avalonia"
        xmlns:windows="using:StockSharp.Xaml.Windows.Avalonia"
        x:Class="StockSharp.Samples.Strategies.LiveSpread.Avalonia.MainWindow"
        Title="Live spread strategy"
        Width="1400"
        Height="900"
        MinWidth="900"
        MinHeight="600"
        WindowStartupLocation="CenterScreen">
  <Grid RowDefinitions="Auto,*">
    <Grid Margin="4" ColumnDefinitions="100,100,220,220,220,100,100,*">
      <Button x:Name="SettingsButton" Margin="2" Content="Settings" Click="OnSettingsClick" />
      <Button x:Name="ConnectButton" Grid.Column="1" Margin="2" Content="Connect" Click="OnConnectClick" />
      <grids:SecurityEditor x:Name="SecurityEditor" Grid.Column="2" Margin="2" />
      <grids:PortfolioEditor x:Name="PortfolioEditor" Grid.Column="3" Margin="2" />
      <editors:CandleDataTypeEdit x:Name="CandleDataTypeEdit" Grid.Column="4" Margin="2" />
      <Button x:Name="StartButton" Grid.Column="5" Margin="2" Content="Start" Click="OnStartClick" />
      <Button x:Name="StopButton" Grid.Column="6" Margin="2" Content="Stop" Click="OnStopClick" IsEnabled="False" />
      <TextBlock x:Name="StatusText" Grid.Column="7" Margin="8,0" VerticalAlignment="Center" Text="Disconnected" />
    </Grid>

    <TabControl Grid.Row="1" Margin="4">
      <TabItem Header="Orders &amp; own trades">
        <Grid RowDefinitions="*,*" ColumnDefinitions="2*,*">
          <grids:OrderGrid x:Name="OrderGrid" Grid.RowSpan="2" />
          <grids:PortfolioGrid x:Name="PortfolioGrid" Grid.Column="1" />
          <grids:MyTradeGrid x:Name="MyTradeGrid" Grid.Row="1" Grid.Column="1" />
        </Grid>
      </TabItem>
      <TabItem Header="Monitor">
        <windows:Monitor x:Name="LogMonitor" />
      </TabItem>
    </TabControl>
  </Grid>
</Window>
