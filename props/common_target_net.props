<Project xmlns="http://schemas.microsoft.com/developer/msbuild/2003">
  <Import Project="common_target_common.props" />
  <PropertyGroup>
    <StockSharpTargets Condition="'$(StockSharpTargets)' == ''">$(NetTfm)</StockSharpTargets>
    <TargetFrameworks>$(StockSharpTargets)</TargetFrameworks>

    <GenerateDocumentationFile>true</GenerateDocumentationFile>
  </PropertyGroup>

  <!-- Diagnostic-only: opt in with -p:StockSharpAotAudit=true.
       Do not mark these assemblies IsAotCompatible until the warnings are resolved. -->
  <PropertyGroup Condition="'$(StockSharpAotAudit)' == 'true' and '$(TargetFramework)' == '$(NetTfm)'">
    <EnableAotAnalyzer>true</EnableAotAnalyzer>
    <EnableTrimAnalyzer>true</EnableTrimAnalyzer>
    <EnableSingleFileAnalyzer>true</EnableSingleFileAnalyzer>
  </PropertyGroup>
</Project>