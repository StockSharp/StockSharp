<Project xmlns="http://schemas.microsoft.com/developer/msbuild/2003">
  <PropertyGroup>
    <IsPackable>false</IsPackable>
    <SampleProjectNameBase>$(MSBuildProjectName)</SampleProjectNameBase>
  </PropertyGroup>
  
  <PropertyGroup Condition="$(_TargetAssemblyProjectName) != ''">
    <SampleProjectNameBase>$(_TargetAssemblyProjectName)</SampleProjectNameBase>
  </PropertyGroup>

  <PropertyGroup>
    <SampleProjectName>$([System.Text.RegularExpressions.Regex]::Replace($(SampleProjectNameBase), '^\d+_(.+?)(_fromsrc)?$', '$1'))</SampleProjectName>
    <!-- An Avalonia sample says so in its name, which is what tells the two builds apart in the
         assembly name. The namespace is what the sources and their x:Class declarations already say,
         so it drops that suffix; the WPF sample keeps the name it has always had. -->
    <SampleNamespace>$([System.Text.RegularExpressions.Regex]::Replace($(SampleProjectName), '_Avalonia$', ''))</SampleNamespace>
    <RootNamespace>StockSharp.Samples.$(SampleNamespace)</RootNamespace>
    <AssemblyName>StockSharp.Samples.$(SampleProjectName)</AssemblyName>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\..\Algo.Indicators\Algo.Indicators.csproj" />
    <ProjectReference Include="..\..\..\Algo.Strategies\Algo.Strategies.csproj" />
  </ItemGroup>
</Project>